---
import { Icon } from "astro-icon/components";
---

<footer class="card bg-base-200/60 backdrop-blur-sm border border-base-300/80 shadow-md p-6 mt-12 transition-all">
  <div class="flex flex-col md:flex-row justify-between items-center gap-6">
    <!-- Secțiunea Stânga: Detalii Autor & Copyright -->
    <div class="space-y-1.5 text-center md:text-left">
      <div class="flex items-center justify-center md:justify-start gap-2">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-bold text-base tracking-wide text-base-content">Alexandru Pleșa</span>
      </div>
      
      <p class="text-xs text-base-content/70">
        © 2026 Alexandru Pleșa • Toate drepturile rezervate.
      </p>

      <p class="text-[11px] text-base-content/50 font-mono">
        Securitate Cibernetică & Dezvoltare Software
      </p>
    </div>

    <!-- Secțiunea Dreapta: Conectare directă & Platforme -->
    <div class="flex flex-col items-center md:items-end gap-2.5">
      <span class="text-[11px] font-bold tracking-widest uppercase text-base-content/50">
        Profiluri & Canale
      </span>

      <div class="flex items-center gap-2">
        <!-- GitHub -->
        <a 
          href="https://github.com/PlesaAlexandru" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-ghost btn-sm btn-square rounded-xl border border-base-300 hover:border-neutral hover:bg-neutral hover:text-neutral-content transition-all"
          title="GitHub"
          aria-label="GitHub"
        >
          <Icon name="ri:github-fill" class="w-4 h-4" />
        </a>

        <!-- LinkedIn -->
        <a 
          href="https://linkedin.com/in/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-ghost btn-sm btn-square rounded-xl border border-base-300 hover:border-blue-500 hover:bg-blue-500 hover:text-white transition-all"
          title="LinkedIn"
          aria-label="LinkedIn"
        >
          <Icon name="ri:linkedin-box-fill" class="w-4 h-4" />
        </a>

        <!-- TryHackMe -->
        <a 
          href="https://tryhackme.com/p/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-ghost btn-sm btn-square rounded-xl border border-base-300 hover:border-rose-500 hover:bg-rose-500 hover:text-white transition-all"
          title="TryHackMe"
          aria-label="TryHackMe"
        >
          <Icon name="simple-icons:tryhackme" class="w-3.5 h-3.5" />
        </a>

        <!-- Hack The Box -->
        <a 
          href="https://app.hackthebox.com/profile/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-ghost btn-sm btn-square rounded-xl border border-base-300 hover:border-emerald-500 hover:bg-emerald-500 hover:text-black transition-all"
          title="Hack The Box"
          aria-label="Hack The Box"
        >
          <Icon name="simple-icons:hackthebox" class="w-3.5 h-3.5" />
        </a>

        <!-- LetsDefend -->
        <a 
          href="https://app.letsdefend.io/user/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-ghost btn-sm btn-square rounded-xl border border-base-300 hover:border-cyan-500 hover:bg-cyan-500 hover:text-black transition-all"
          title="LetsDefend"
          aria-label="LetsDefend"
        >
          <Icon name="ri:shield-keyhole-line" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</footer>

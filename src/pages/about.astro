---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout title="About | Alexandru Pleșa">
  <div class="max-w-4xl mx-auto py-10 px-4 space-y-12">
    
    <!-- Header Profil & Bio -->
    <section class="flex flex-col sm:flex-row items-center sm:items-start gap-6 card bg-base-200/50 border border-base-300/80 p-6 sm:p-8 rounded-2xl shadow-sm">
      <div class="avatar shrink-0">
        <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl ring-2 ring-primary ring-offset-2 ring-offset-base-100 overflow-hidden shadow-md">
          <img src="/avatar.png" alt="Alexandru Pleșa" class="object-cover w-full h-full" />
        </div>
      </div>

      <div class="space-y-4 text-center sm:text-left flex-1">
        <div>
          <h1 class="text-3xl font-extrabold tracking-tight text-base-content">Alexandru Pleșa</h1>
          <p class="text-primary font-medium text-sm mt-0.5">Aspiring SOC Analyst (L1) • Cybersecurity Enthusiast</p>
        </div>

        <p class="text-sm text-base-content/80 leading-relaxed">
          Driven cybersecurity enthusiast dedicated to defending infrastructure and mastering blue team fundamentals. 
          Currently training daily in alert triage, packet inspection, SIEM logic, and log forensics, while actively dissecting attacker techniques in hands-on CTF environments.
        </p>

        <!-- Acțiuni: Download CV & Contact -->
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 pt-1">
          <!-- Buton CV: Pune fișierul tău CV.pdf în folderul public/ -->
          <a 
            href="/cv.pdf" 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm gap-2 shadow-sm"
          >
            <Icon name="ri:file-download-line" class="w-4 h-4" />
            Download CV
          </a>
          <a href="/contact" class="btn btn-outline btn-sm border-base-300 gap-2">
            <Icon name="ri:mail-line" class="w-4 h-4" />
            Contact Me
          </a>
        </div>
      </div>
    </section>

    <!-- Roadmap & Milestones (Timeline) -->
    <section class="space-y-6">
      <div class="space-y-1">
        <h2 class="text-xl font-bold tracking-tight text-base-content flex items-center gap-2">
          <Icon name="ri:route-line" class="w-5 h-5 text-primary" />
          Cybersecurity Journey & Roadmap
        </h2>
        <p class="text-xs text-base-content/60">Milestones, current studies, and target certifications.</p>
      </div>

      <!-- Timeline DaisyUI nativ -->
      <ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical">
        
        <!-- Step 1: Prezent / În desfășurare -->
        <li>
          <div class="timeline-middle">
            <span class="flex h-4 w-4 rounded-full bg-primary/20 items-center justify-center">
              <span class="h-2 w-2 rounded-full bg-primary animate-ping"></span>
            </span>
          </div>
          <div class="timeline-start mb-10 md:text-end">
            <time class="font-mono text-xs text-primary font-semibold">2026 • CURRENT</time>
            <div class="text-base font-bold text-base-content">SOC L1 Readiness & Deep-Dive Labs</div>
            <p class="text-xs text-base-content/70 mt-1">
              Active investigation of simulated SOC incidents on LetsDefend, packet dissection with Wireshark, and mapping adversary behavior to the MITRE ATT&CK framework.
            </p>
          </div>
          <hr class="bg-base-300" />
        </li>

        <!-- Step 2: Certificări & Formare tehnică -->
        <li>
          <hr class="bg-base-300" />
          <div class="timeline-middle">
            <Icon name="ri:checkbox-circle-fill" class="w-4 h-4 text-emerald-400" />
          </div>
          <div class="timeline-end mb-10">
            <time class="font-mono text-xs text-base-content/50">2025 – 2026</time>
            <div class="text-base font-bold text-base-content">Hands-On Foundations (THM & HTB)</div>
            <p class="text-xs text-base-content/70 mt-1">
              Completed foundational learning paths in defensive security, network fundamentals, Linux forensics, and basic penetration testing to understand attacker methodologies.
            </p>
          </div>
          <hr class="bg-base-300" />
        </li>

        <!-- Step 3: Startul în domeniu -->
        <li>
          <hr class="bg-base-300" />
          <div class="timeline-middle">
            <Icon name="ri:flag-fill" class="w-4 h-4 text-base-content/40" />
          </div>
          <div class="timeline-start mb-10 md:text-end">
            <time class="font-mono text-xs text-base-content/50">INITIAL SPARK</time>
            <div class="text-base font-bold text-base-content">Networking & Systems Engineering</div>
            <p class="text-xs text-base-content/70 mt-1">
              Building home labs, exploring operating system internals, scripting automation tools with Python/Bash, and discovering the defensive side of security.
            </p>
          </div>
        </li>

      </ul>
    </section>

    <!-- Evenimente, Conferințe & Comunitate -->
    <section class="card bg-base-200/40 border border-base-300/80 p-6 rounded-2xl space-y-4">
      <h2 class="text-lg font-bold text-base-content flex items-center gap-2">
        <Icon name="ri:calendar-event-line" class="w-5 h-5 text-primary" />
        Events, CTFs & Community
      </h2>
      <p class="text-xs text-base-content/70 leading-relaxed">
        I believe continuous learning thrives in community. I actively participate in local security meetups, industry conferences, and online CTF challenges to sharpen my analytical mindset and stay up to date with emerging threat landscapes.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
        <div class="flex items-start gap-3 p-3 rounded-xl bg-base-100/60 border border-base-300/60">
          <Icon name="ri:trophy-line" class="w-5 h-5 text-yellow-500 shrink-0 mt-0.5" />
          <div class="text-xs">
            <div class="font-bold text-base-content">CTF Competitions</div>
            <div class="text-base-content/60">Regular participant in beginner/intermediate CTFs, focusing on forensics & network tasks.</div>
          </div>
        </div>

        <div class="flex items-start gap-3 p-3 rounded-xl bg-base-100/60 border border-base-300/60">
          <Icon name="ri:community-line" class="w-5 h-5 text-blue-400 shrink-0 mt-0.5" />
          <div class="text-xs">
            <div class="font-bold text-base-content">Conferences & Workshops</div>
            <div class="text-base-content/60">Engaging in cybersecurity talks, webinars, and open security communities.</div>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

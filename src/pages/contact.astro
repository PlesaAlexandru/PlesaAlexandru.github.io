---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout title="Contact">
  <section class="max-w-3xl mx-auto py-8 px-4 space-y-8">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-base-content mb-2">Contact & Profiles</h1>
      <p class="text-base-content/70">
        You can reach out or find my professional and cybersecurity profiles below.
      </p>
    </div>

    <!-- Informații de bază / Quick Info -->
    <div class="card bg-base-200 border border-base-300 shadow-sm p-6 space-y-3">
      <div class="flex items-center gap-3">
        <span class="badge badge-primary font-semibold">Location</span>
        <span class="text-base-content font-medium">Romania</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="badge badge-secondary font-semibold">Email</span>
        <span class="text-base-content select-all font-mono font-medium">plesaalexandru@gmail.com</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="badge badge-accent font-semibold">Status</span>
        <span class="text-base-content">Open for collaborations, CTFs, and security discussions</span>
      </div>
    </div>

    <!-- Butoane Profiluri / Profiles -->
    <div class="space-y-4">
      <h2 class="text-xl font-bold text-base-content">CyberSec & Development Platforms</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- GitHub -->
        <a 
          href="https://github.com/PlesaAlexandru" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-outline btn-neutral justify-start gap-3 h-auto py-3 px-4 transition-all hover:-translate-y-0.5"
        >
          <Icon name="ri:github-fill" class="w-6 h-6 shrink-0" />
          <div class="text-left">
            <div class="font-bold">GitHub</div>
            <div class="text-xs opacity-70">Repositories and open-source projects</div>
          </div>
        </a>

        <!-- LinkedIn -->
        <a 
          href="https://linkedin.com/in/LINK_UL_TAU" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-outline btn-primary justify-start gap-3 h-auto py-3 px-4 transition-all hover:-translate-y-0.5"
        >
          <Icon name="ri:linkedin-box-fill" class="w-6 h-6 shrink-0" />
          <div class="text-left">
            <div class="font-bold">LinkedIn</div>
            <div class="text-xs opacity-70">Professional profile and network</div>
          </div>
        </a>

        <!-- TryHackMe -->
        <a 
          href="https://tryhackme.com/p/USERNAME_UL_TAU" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-outline btn-error justify-start gap-3 h-auto py-3 px-4 transition-all hover:-translate-y-0.5"
        >
          <Icon name="simple-icons:tryhackme" class="w-6 h-6 shrink-0" />
          <div class="text-left">
            <div class="font-bold">TryHackMe</div>
            <div class="text-xs opacity-70">Rank and learning pathways</div>
          </div>
        </a>

        <!-- Hack The Box -->
        <a 
          href="https://app.hackthebox.com/profile/ID_UL_TAU" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-outline btn-success justify-start gap-3 h-auto py-3 px-4 transition-all hover:-translate-y-0.5"
        >
          <Icon name="simple-icons:hackthebox" class="w-6 h-6 shrink-0" />
          <div class="text-left">
            <div class="font-bold">Hack The Box</div>
            <div class="text-xs opacity-70">Pwned machines and badges</div>
          </div>
        </a>

        <!-- LetsDefend -->
        <a 
          href="https://app.letsdefend.io/user/USERNAME_UL_TAU" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-outline btn-info justify-start gap-3 h-auto py-3 px-4 transition-all hover:-translate-y-0.5 sm:col-span-2"
        >
          <Icon name="ri:shield-keyhole-line" class="w-6 h-6 shrink-0" />
          <div class="text-left">
            <div class="font-bold">LetsDefend</div>
            <div class="text-xs opacity-70">SOC Analyst & Blue Team training</div>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout title="Contact">
  <section class="max-w-3xl mx-auto py-8 px-4 space-y-8">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-base-content mb-2">Contact</h1>
      <p class="text-base-content/70">
        Mă poți găsi sau contacta direct prin canalele de mai jos.
      </p>
    </div>

    <!-- Informații de bază -->
    <div class="card bg-base-200 border border-base-300 shadow-sm p-6 space-y-3">
      <div class="flex items-center gap-3">
        <span class="badge badge-primary font-semibold">Locație</span>
        <span class="text-base-content font-medium">România</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="badge badge-secondary font-semibold">Email</span>
        <span class="text-base-content select-all font-mono font-medium">plesaalexandru@gmail.com</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="badge badge-accent font-semibold">Status</span>
        <span class="text-base-content">Deschis pentru colaborări și proiecte</span>
      </div>
    </div>

    <!-- Butoane de profiluri integrate în tema site-ului -->
    <div class="space-y-4">
      <h2 class="text-xl font-bold text-base-content">Profiluri & Canale</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- GitHub -->
        <a 
          href="https://github.com/PlesaAlexandru" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-outline btn-neutral justify-start gap-3 h-auto py-3 px-4 transition-all hover:-translate-y-0.5"
        >
          <Icon name="ri:github-fill" class="w-6 h-6 shrink-0" />
          <div class="text-left">
            <div class="font-bold">GitHub</div>
            <div class="text-xs opacity-70">Urmărește proiectele mele</div>
          </div>
        </a>

        <!-- LinkedIn -->
        <a 
          href="https://linkedin.com/in/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-outline btn-primary justify-start gap-3 h-auto py-3 px-4 transition-all hover:-translate-y-0.5"
        >
          <Icon name="ri:linkedin-box-fill" class="w-6 h-6 shrink-0" />
          <div class="text-left">
            <div class="font-bold">LinkedIn</div>
            <div class="text-xs opacity-70">Conectează-te profesional</div>
          </div>
        </a>

        <!-- Telegram -->
        <a 
          href="https://t.me/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-outline btn-secondary justify-start gap-3 h-auto py-3 px-4 transition-all hover:-translate-y-0.5"
        >
          <Icon name="ri:telegram-fill" class="w-6 h-6 shrink-0" />
          <div class="text-left">
            <div class="font-bold">Telegram</div>
            <div class="text-xs opacity-70">Mesagerie directă</div>
          </div>
        </a>

        <!-- X (Twitter) -->
        <a 
          href="https://x.com/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-outline btn-accent justify-start gap-3 h-auto py-3 px-4 transition-all hover:-translate-y-0.5"
        >
          <Icon name="ri:twitter-x-fill" class="w-6 h-6 shrink-0" />
          <div class="text-left">
            <div class="font-bold">X (Twitter)</div>
            <div class="text-xs opacity-70">Gânduri și update-uri</div>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

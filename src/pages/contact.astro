---
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="Contact">
  <div class="max-w-2xl mx-auto py-10 px-4">
    <h1 class="text-3xl font-bold mb-4">Contact</h1>
    <p class="text-base-content/70 mb-8">
      Ai o întrebare sau vrei să colaborăm? Lasă-mi un mesaj mai jos.
    </p>

    <!-- Formular de contact -->
    <form 
      action="https://formspree.io/f/ID_UL_TAU_AICI" 
      method="POST" 
      class="flex flex-col gap-4"
    >
      <div>
        <label for="name" class="block text-sm font-medium mb-1">Nume</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          required 
          class="input input-bordered w-full"
          placeholder="Numele tău"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium mb-1">Email</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          class="input input-bordered w-full"
          placeholder="adresa.ta@exemplu.com"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium mb-1">Mesaj</label>
        <textarea 
          id="message" 
          name="message" 
          rows="5" 
          required 
          class="textarea textarea-bordered w-full"
          placeholder="Scrie mesajul tău aici..."
        ></textarea>
      </div>

      <button type="submit" class="btn btn-primary self-start mt-2">
        Trimite mesajul
      </button>
    </form>
  </div>
</MainLayout>

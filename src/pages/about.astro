---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

const roadmap = [
  {
    period: "December 2026",
    status: "planned",
    title: "Preparing for CompTIA Security+",
    description: "Gaining comprehensive knowledge in core cybersecurity principles, risk management, threat intelligence, cryptography, and network security architecture to prepare for industry-standard certification. Also, in this period I will be attempting Advent of Cyber on TryHackMe and other challenges to solidify the knowledge.",
    tags: ["CompTIA Security+", "Certification Preparation", "Future Plans", "CTFs"]
  },
  {
    period: "November 2026",
    status: "planned",
    title: "Preparing for Google Cybersecurity Certificate",
    description: "Pursuing the Google Cybersecurity professional certification while actively documenting progress, building hands-on projects, publishing write-ups, and engaging with the community.",
    tags: ["Google Cybersecurity Certificate", "Certification Preparation", "Near Future", ]
  },
  {
    period: "October 2026",
    status: "active",
    title: "SOC L1 Preparation & Detection Labs (SOC L1 Learning Path)",
    description: "Deepening hands-on investigation workflows via TryHackMe (SOC L1 Learning path, CTFs, Challenges) and enterprise alert simulations (Splunk mainly). Working on packet inspection with Wireshark, SIEM query, IDS rules. Also there, as a team, we managed to get ~29/1700 teams in Downtime CTF (An TryHackMe CTF focused on Blue Team) and Hackout #5th edition (Osint, Forensics CTF).",
    tags: ["Snort", "Splunk", "Wireshark", "MITRE ATT&CK", "Downtime - CTF", "Hackout - CTF"]
  },
  {
    period: "September-October 2026",
    status: "completed",
    title: "Cyber Security 101 - TryHackMe",
    description: "Building foundation and developing essential skills in log analysis, Linux administration, and hands-on penetration testing methodologies to understand core security concepts and threat identification.",
    tags: ["Splunk - Basic", "Elastic - Basic", "Linux logs", "Windows logs"]
  },
  {
    period: "July-August 2026",
    status: "completed",
    title: "Pre Security - TryHackMe",
    description: "Theorethical hands-on fundamentals across TryHackMe and other platforms such as Let's Defend, Hack the Box, Cisco and online resources. Studied adversary techniques, Windows event logs, and Linux system telemetry. Also in this period I completed Pre Security learning path.",
    tags: ["Fundamentals", "TCP/UDP", "Networking", "Introduction to Linux/Windows"]
  },
  {
    period: "June 2018",
    status: "completed",
    title: "Penetration Testing Intern (Temporary / Project based)",
    description: "I was introduced into Web Penetration Testing by a friend who worked at SmartMedia. We found an critical vulnerability via parameter tampering we could change the hidden role to admin and obtain an Administrator account when resetting password. No contract was made but more of an learning opportunity.",
    tags: ["Burp Suite", "Protocols", "Vulnerability", "Web Penetration Testing"]
  }
];
---

<BaseLayout title="About | Alexandru Pleșa">
  <div class="max-w-4xl mx-auto py-10 px-4 space-y-12">
    
    <!-- Header Profil -->
    <header class="card bg-slate-800/60 border border-slate-700/80 shadow-xl p-7 sm:p-9 rounded-2xl space-y-5">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-primary uppercase tracking-wider">
          <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
          Profile & Background
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-base-content">
          Pleșa Alexandru-Florin
        </h1>
        <p class="text-base sm:text-lg font-semibold text-primary">
          Aspiring SOC Analyst (L1) • Cybersecurity Enthusiast
        </p>
      </div>

      <p class="text-base text-base-content/85 leading-relaxed max-w-2xl">
        Focused on defensive operations, alert investigation, and security telemetry. 
        Currently preparing for an entry-level L1 SOC role by analyzing realistic attack data, dissecting packet captures, and testing detection logic.
        Part of the InvataCyber.ro team as contributor helping newer enthusiasts, providing resources and steps based on guidance from higher skilled specialists in Cybersecurity.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a 
          href="/cv.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-primary gap-2 shadow-md text-sm font-semibold"
        >
          <Icon name="ri:file-download-line" class="w-4 h-4" />
          Download CV
        </a>
        <a href="/contact" class="btn bg-slate-700/60 border border-slate-600/70 hover:border-primary text-sm font-semibold gap-2">
          <Icon name="ri:mail-line" class="w-4 h-4" />
          Get in Touch
        </a>
      </div>
    </header>

    <!-- Secțiunea Roadmap -->
    <section class="space-y-6">
      <div class="space-y-1">
        <h2 class="text-2xl font-bold tracking-tight text-base-content flex items-center gap-2">
          <Icon name="ri:route-line" class="w-6 h-6 text-primary" />
          Roadmap & Milestone Progression
        </h2>
        <p class="text-sm text-base-content/70">
          Chronological breakdown of security studies, lab milestones, and focus areas.
        </p>
      </div>

      <!-- Containerul liniei albastre -->
      <div class="relative pl-7 sm:pl-9 border-l-2 border-primary/50 ml-3 sm:ml-4 space-y-7 py-2">
        {roadmap.map((item) => (
          <div class="relative group">
            <!-- Punctul luminos pe linia albastră -->
            <div class={`absolute -left-[35px] sm:-left-[43px] top-6 w-4 h-4 rounded-full border-2 bg-slate-900 ${
              item.status === 'active' 
                ? 'border-primary ring-4 ring-primary/20 bg-primary' 
                : 'border-primary/60 group-hover:border-primary group-hover:bg-primary/50 transition-colors'
            }`}></div>

            <!-- Card cu ierarhie identică cu a articolelor din Blog -->
            <div class="card bg-slate-800/60 border border-slate-700/80 shadow-lg p-6 sm:p-7 rounded-2xl space-y-4 hover:border-primary/60 transition-all">
              
              <!-- Metadate sus (dată / status) -->
              <div class="flex flex-wrap items-center justify-between gap-3 text-xs sm:text-sm text-base-content/70">
                <div class="flex items-center gap-2 font-medium">
                  <Icon name="ri:calendar-line" class="w-4 h-4 text-primary" />
                  <span>{item.period}</span>
                </div>
                {item.status === 'active' && (
                  <span class="badge badge-primary font-semibold text-xs py-2 px-2.5">
                    In Progress
                  </span>
                )}
              </div>

              <!-- Titlu mărit exact ca în Blog -->
              <h3 class="text-xl sm:text-2xl font-bold text-base-content group-hover:text-primary transition-colors leading-snug">
                {item.title}
              </h3>

              <!-- Descriere la mărime standard text-sm / text-base, aerisită -->
              <p class="text-sm sm:text-base text-base-content/85 leading-relaxed">
                {item.description}
              </p>

              <!-- Tag-uri vizibile cu fundal fin și iconiță -->
              <div class="flex flex-wrap gap-2 pt-2 border-t border-slate-700/60">
                {item.tags.map((tag) => (
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-slate-700/50 border border-slate-600/60 text-sky-300">
                    <Icon name="ri:price-tag-3-line" class="w-3.5 h-3.5 opacity-70" />
                    {tag}
                  </span>
                ))}
              </div>

            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

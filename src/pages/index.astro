---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---

<BaseLayout title="Alexandru Pleșa | Aspiring SOC Analyst L1">
  <div class="max-w-4xl mx-auto py-10 px-4 space-y-14">
    
    <!-- Hero Section -->
    <header class="space-y-5">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/15 border border-sky-500/30 text-sky-300 text-xs font-semibold tracking-wide">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse"></span>
        Targeting Entry-Level / Junior SOC Analyst (L1) Roles
      </div>

      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-base-content leading-tight">
        Hi, I'm <span class="text-primary">Pleșa Alexandru-Florin </span>.
      </h1>

      <p class="text-base sm:text-lg text-base-content/85 max-w-2xl leading-relaxed">
        Passionate learner preparing for an entry-level role as a <strong class="text-primary font-bold">SOC Analyst L1</strong>. 
        Focusing heavily on alert triage, security telemetry, log forensics, and essential adversary emulation to build resilient defenses.
      </p>

      <div class="flex flex-wrap gap-3.5 pt-2">
        <a href="/contact" class="btn btn-primary gap-2 shadow-lg font-semibold text-sm">
          <Icon name="ri:send-plane-fill" class="w-4 h-4" />
          Get in Touch / Profiles
        </a>
        <a href="/blog" class="btn bg-slate-800/60 border border-slate-700/80 gap-2 hover:border-primary text-sm font-semibold">
          <Icon name="ri:file-list-3-line" class="w-4 h-4" />
          Lab Writeups
        </a>
        <a href="https://github.com/PlesaAlexandru" target="_blank" rel="noopener noreferrer" class="btn bg-slate-800/60 border border-slate-700/80 btn-square hover:border-primary" title="GitHub">
          <Icon name="ri:github-fill" class="w-5 h-5" />
        </a>
      </div>
    </header>

    <!-- Core Focus: Carduri proporționate cu text lizibil -->
    <section class="space-y-5">
      <h2 class="text-2xl font-bold tracking-tight text-base-content flex items-center gap-2.5">
        <Icon name="ri:shield-flash-line" class="w-6 h-6 text-primary" />
        Core Focus & Security Capabilities
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Card 1 -->
        <div class="card bg-slate-800/60 border border-primary/50 shadow-xl p-6 sm:p-7 rounded-2xl space-y-4 hover:border-primary transition-all relative">
          <div class="absolute top-4 right-4 badge badge-primary font-semibold text-xs py-2 px-2.5">Primary Focus</div>
          <div class="w-12 h-12 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold">
            <Icon name="ri:radar-line" class="w-6 h-6" />
          </div>
          <div class="space-y-2">
            <h3 class="font-bold text-lg text-base-content">Alert Triage & SIEM</h3>
            <p class="text-sm text-base-content/85 leading-relaxed">
              Investigating simulated incidents on LetsDefend, validating false positives, and analyzing telemetry across Sysmon and Windows logs.
            </p>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="card bg-slate-800/60 border border-slate-700/80 shadow-xl p-6 sm:p-7 rounded-2xl space-y-4 hover:border-primary/50 transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold">
            <Icon name="ri:mail-forbid-line" class="w-6 h-6" />
          </div>
          <div class="space-y-2">
            <h3 class="font-bold text-lg text-base-content">Phishing & PCAP Analysis</h3>
            <p class="text-sm text-base-content/85 leading-relaxed">
              Deconstructing headers, malicious attachments, and analyzing network traffic captures in Wireshark.
            </p>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="card bg-slate-800/60 border border-slate-700/80 shadow-xl p-6 sm:p-7 rounded-2xl space-y-4 hover:border-primary/50 transition-all">
          <div class="w-12 h-12 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center font-bold">
            <Icon name="ri:sword-line" class="w-6 h-6" />
          </div>
          <div class="space-y-2">
            <h3 class="font-bold text-lg text-base-content">Adversary Tactics (CTFs)</h3>
            <p class="text-sm text-base-content/85 leading-relaxed">
              Practicing foundational offensive techniques on TryHackMe and HTB to map real attacker behavior directly to MITRE ATT&CK.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Articole Recente: Format identic cu cel din pagina de Blog -->
    <section class="space-y-5">
      <div class="flex justify-between items-center">
        <h2 class="text-2xl font-bold tracking-tight text-base-content flex items-center gap-2.5">
          <Icon name="ri:book-read-line" class="w-6 h-6 text-primary" />
          Recent Lab Writeups & Studies
        </h2>
        <a href="/blog" class="text-sm font-semibold text-primary hover:underline flex items-center gap-1">
          View all posts <Icon name="ri:arrow-right-line" class="w-4 h-4" />
        </a>
      </div>

      <div class="space-y-4">
        {recentPosts.length > 0 ? (
          recentPosts.map((post) => (
            <a 
              href={`/blog/${post.id}`} 
              class="group card bg-slate-800/60 border border-slate-700/80 shadow-lg p-6 sm:p-7 rounded-2xl hover:border-primary/60 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4"
            >
              <div class="space-y-2">
                <h3 class="font-bold text-lg sm:text-xl text-base-content group-hover:text-primary transition-colors leading-snug">
                  {post.data.title}
                </h3>
                <p class="text-sm sm:text-base text-base-content/75 line-clamp-1 leading-relaxed">
                  {post.data.description}
                </p>
              </div>
              <div class="flex items-center gap-2 text-xs sm:text-sm font-medium text-base-content/60 shrink-0">
                <Icon name="ri:calendar-line" class="w-4 h-4 text-primary" />
                <span>{new Date(post.data.pubDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
              </div>
            </a>
          ))
        ) : (
          <div class="card bg-slate-800/40 border border-dashed border-slate-700 p-8 text-center text-sm text-base-content/60">
            No lab writeups published yet. Add your notes in <code class="font-mono">src/content/blog/</code>!
          </div>
        )}
      </div>
    </section>

  </div>
</BaseLayout>

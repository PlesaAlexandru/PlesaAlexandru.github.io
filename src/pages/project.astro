---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

// Pentru fiecare proiect poți adăuga imagine în public/projects/nume-poza.png
const projects = [
  {
    title: "SOC Homelab & Incident Triage Pipeline",
    description: "Built an isolated virtual lab reproducing Active Directory environments. Configured Sysmon, forwarded telemetry to an open-source SIEM, and simulated real-world attack scenarios to build and test custom detection rules.",
    tags: ["Sysmon", "SIEM", "Splunk / ELK", "Windows Event Logs"],
    image: "/projects/homelab.png", // Pune poza în public/projects/homelab.png
    github: "https://github.com/PlesaAlexandru",
    writeup: "/blog",
    featured: true,
  },
  {
    title: "Automated Phishing Analyzer & Triage Script",
    description: "Python CLI tool parsing raw .eml files to extract IP reputation, header anomalies, SPF/DKIM alignment, and quarantined attachment hashes queried against VirusTotal API.",
    tags: ["Python", "VirusTotal API", "Email Forensics", "Threat Intel"],
    image: "/projects/phishing-analyzer.png",
    github: "https://github.com/PlesaAlexandru",
    featured: true,
  },
  {
    title: "PCAP Dissector & Suspicious Beaconing Detector",
    description: "Network capture analysis utility built with Scapy and Tshark to identify anomalous outbound HTTP/DNS beaconing intervals and covert DNS tunneling patterns.",
    tags: ["Wireshark", "Scapy", "Network Security", "Bash"],
    image: "/projects/pcap-dissector.png",
    github: "https://github.com/PlesaAlexandru",
    featured: false,
  },
  {
    title: "Linux Hardening & Security Audit Baseline",
    description: "Modular Bash scripts aligning Debian/Ubuntu server environments with CIS benchmark baselines, covering SSH restrictions, firewall rules, and active audit configurations.",
    tags: ["Linux", "Bash", "CIS Benchmark", "Hardening"],
    image: "/projects/linux-hardening.png",
    github: "https://github.com/PlesaAlexandru",
    featured: false,
  },
];
---

<BaseLayout title="Projects | Alexandru Pleșa">
  <div class="max-w-5xl mx-auto py-10 px-4 space-y-10">
    
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-primary font-semibold tracking-wider uppercase">
        <Icon name="ri:file-code-line" class="w-4 h-4" />
        Lab Work & Tooling
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-base-content">
        Hands-on Projects
      </h1>
      <p class="text-base text-base-content/80 max-w-2xl leading-relaxed">
        Defensive security implementations, homelab configurations, detection engineering tests, and automation utilities.
      </p>
    </header>

    <!-- Grilă Proiecte cu Spațiu de Imagini -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((proj) => (
        <article class="card bg-slate-800/50 border border-slate-700/80 shadow-xl rounded-2xl overflow-hidden flex flex-col justify-between hover:border-primary/60 transition-all group">
          
          <!-- Imagine / Preview container -->
          <div class="relative w-full aspect-video bg-slate-900/80 border-b border-slate-700/60 overflow-hidden flex items-center justify-center">
            {proj.image ? (
              <img 
                src={proj.image} 
                alt={proj.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
            ) : null}
            <!-- Fallback elegant dacă nu există încă poza -->
            <div class={`flex-col items-center justify-center gap-2 text-slate-500 ${proj.image ? 'hidden' : 'flex'}`}>
              <Icon name="ri:image-line" class="w-8 h-8 opacity-40" />
              <span class="text-xs font-mono uppercase tracking-wider opacity-60">Screenshot Preview</span>
            </div>
            
            {proj.featured && (
              <span class="absolute top-3 right-3 badge badge-primary text-xs font-semibold shadow-md">
                Featured
              </span>
            )}
          </div>

          <!-- Corpul Proiectului: Text mai mare și bine aerisit -->
          <div class="p-6 space-y-4 flex-1 flex flex-col justify-between">
            <div class="space-y-2.5">
              <h2 class="text-lg sm:text-xl font-bold text-base-content leading-snug group-hover:text-primary transition-colors">
                {proj.title}
              </h2>
              <p class="text-sm text-base-content/85 leading-relaxed">
                {proj.description}
              </p>
            </div>

            <div class="space-y-4 pt-2">
              <!-- Tag-uri -->
              <div class="flex flex-wrap gap-1.5">
                {proj.tags.map((t) => (
                  <span class="badge bg-slate-700/60 border border-slate-600/40 text-xs font-mono text-slate-300 py-2.5 px-3">
                    {t}
                  </span>
                ))}
              </div>

              <!-- Butoane -->
              <div class="flex items-center gap-3 pt-3 border-t border-slate-700/60">
                {proj.github && (
                  <a
                    href={proj.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-sm btn-ghost gap-2 text-xs font-semibold hover:text-primary"
                  >
                    <Icon name="ri:github-fill" class="w-4 h-4" />
                    Source Code
                  </a>
                )}
                {proj.writeup && (
                  <a
                    href={proj.writeup}
                    class="btn btn-sm btn-ghost gap-2 text-xs font-semibold text-primary"
                  >
                    <Icon name="ri:article-line" class="w-4 h-4" />
                    Read Writeup
                  </a>
                )}
              </div>
            </div>

          </div>
        </article>
      ))}
    </section>

  </div>
</BaseLayout>

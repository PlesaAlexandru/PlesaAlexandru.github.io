---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

const projects = [
  {
    title: "SOC Homelab & Incident Triage Pipeline",
    description: "Built an isolated virtual lab reproducing AD enterprise environments. Configured Sysmon, forwarded telemetry to an open-source SIEM, and generated realistic attack traffic to write detection rules.",
    tags: ["Sysmon", "SIEM", "Splunk / ELK", "Windows Event Logs"],
    github: "https://github.com/PlesaAlexandru",
    writeup: "/blog",
    featured: true,
  },
  {
    title: "Automated Phishing Analyzer & Triage Script",
    description: "Python CLI tool parsing .eml files to extract IP reputation, header anomalies, DKIM/SPF alignment, and quarantined attachment hashes checked against VirusTotal API.",
    tags: ["Python", "VirusTotal API", "Email Forensics", "Threat Intel"],
    github: "https://github.com/PlesaAlexandru",
    featured: true,
  },
  {
    title: "PCAP Dissector & Suspicious Beaconing Detector",
    description: "Network capture analysis utility using Scapy/Tshark to identify anomalous outbound HTTP/DNS beaconing intervals and DNS tunneling patterns.",
    tags: ["Wireshark", "Scapy", "Network Security", "Bash"],
    github: "https://github.com/PlesaAlexandru",
    featured: false,
  },
  {
    title: "Linux Hardening & Baseline Audit Scripts",
    description: "Modular Bash scripts aligning Ubuntu/Debian server configurations with basic CIS benchmark recommendations (SSH hardening, firewall rules, user privilege review).",
    tags: ["Linux", "Bash", "Hardening", "Audit"],
    github: "https://github.com/PlesaAlexandru",
    featured: false,
  },
];
---

<BaseLayout title="Projects | Alexandru Pleșa">
  <div class="max-w-4xl mx-auto py-10 px-4 space-y-10">
    
    <header class="space-y-2">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-primary font-semibold">
        <Icon name="ri:file-code-line" class="w-4 h-4" />
        PORTFOLIO / LABS
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-base-content">
        Projects & Hands-on Work
      </h1>
      <p class="text-sm text-base-content/80 max-w-2xl">
        Practical implementations covering security monitoring, log pipeline automation, tool development, and homelab engineering.
      </p>
    </header>

    <!-- Grilă cu carduri solide cu relief ca în blogs -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {projects.map((proj) => (
        <article class={`card bg-base-200 border ${proj.featured ? 'border-primary/50 shadow-lg' : 'border-base-300 shadow-md'} p-6 rounded-2xl flex flex-col justify-between hover:border-primary/60 transition-all space-y-4`}>
          <div class="space-y-3">
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-lg font-bold text-base-content leading-snug">
                {proj.title}
              </h2>
              {proj.featured && (
                <span class="badge badge-primary badge-sm shrink-0 font-medium">Featured</span>
              )}
            </div>

            <p class="text-xs text-base-content/80 leading-relaxed">
              {proj.description}
            </p>

            <div class="flex flex-wrap gap-1.5 pt-1">
              {proj.tags.map((t) => (
                <span class="badge badge-neutral bg-base-300 border-none badge-sm font-mono text-[10px] text-base-content/80">
                  {t}
                </span>
              ))}
            </div>
          </div>

          <div class="flex items-center gap-3 pt-3 border-t border-base-300">
            {proj.github && (
              <a
                href={proj.github}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost btn-xs gap-1.5 font-medium hover:text-primary"
              >
                <Icon name="ri:github-fill" class="w-3.5 h-3.5" />
                Source Code
              </a>
            )}
            {proj.writeup && (
              <a
                href={proj.writeup}
                class="btn btn-ghost btn-xs gap-1.5 font-medium text-primary"
              >
                <Icon name="ri:article-line" class="w-3.5 h-3.5" />
                Read Writeup
              </a>
            )}
          </div>
        </article>
      ))}
    </section>

  </div>
</BaseLayout>
